{
  "name": "claude-on-dsh",
  "version": "2.1.1",
  "private": true,
  "description": "Claude on DSH: Claude Code CLI or Desktop plans a project, hands it to DSH, and adds editable opening questions, handoffs, post-turn Claude review, and a reviewed development document.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huajikano/claude-on-dsh.git"
  },
  "homepage": "https://github.com/huajikano/claude-on-dsh#readme",
  "bugs": {
    "url": "https://github.com/huajikano/claude-on-dsh/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "claude-on-dsh-acceptance": "./bin/acceptance.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "screenshots.json",
    "lib",
    "bin",
    "docs",
    "test",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-reporter spec \"test/acceptance/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}

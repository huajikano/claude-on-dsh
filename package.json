{
  "name": "claude-on-dsh",
  "version": "1.0.1",
  "private": true,
  "description": "Claude on DSH: the local Claude Code CLI (or Claude Desktop) runs a new project's opening question and plan, then DSH executes the handoff; 1.0.1 adds an evidence-based acceptance gate after the session runs.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huajikano/claude-on-dsh.git"
  },
  "homepage": "https://github.com/huajikano/claude-on-dsh#readme",
  "bugs": {
    "url": "https://github.com/huajikano/claude-on-dsh/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "claude-on-dsh-acceptance": "./bin/acceptance.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib",
    "bin",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/acceptance/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
